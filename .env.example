# Names only. Provision values through Vercel/environment secret stores.
# App runtime uses DATABASE_URL (pooled Neon). drizzle-kit migrate/studio prefer
# DATABASE_URL_UNPOOLED (direct TCP host, no -pooler) when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

AUTH_SECRET=
AUTH_URL=
# Required on Vercel/custom domains (Auth.js UntrustedHost otherwise)
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Places API (New) — server-only. Enable places.googleapis.com in Google Cloud.
# Prefer API restriction to Places API (New); never expose as NEXT_PUBLIC_*.
GOOGLE_PLACES_API_KEY=

EMAIL_SERVER=
EMAIL_FROM=

BLOB_READ_WRITE_TOKEN=
FILE_STORE=

ESIGN_PROVIDER=sandbox
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
ESIGN_TEMPLATE_VERSION_DE=
ESIGN_TEMPLATE_VERSION_EN=

CRON_SECRET=
# Optional dedicated key for encrypting ICS feed URLs; falls back to AUTH_SECRET
CALENDAR_SECRETS_KEY=
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=
# Optional Spamblock contact form endpoint (defaults to the Salon form id).
NEXT_PUBLIC_SPAMBLOCK_FORM_URL=

# Comma-separated hostnames for phone/LAN `next dev` (no scheme/port).
# Example: ALLOWED_DEV_ORIGINS=172.20.10.8
ALLOWED_DEV_ORIGINS=

# Explicit guard for scripts/seed.ts
ALLOW_DB_SEED=

# Explicit guard for scripts/reset-dev-data.ts (DROP SCHEMA + migrate + blob wipe)
ALLOW_DB_RESET=

# Explicit guard for scripts/set-staff.ts in production
ALLOW_SET_STAFF=
